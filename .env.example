# Copy this file to .env.local (local) or add these in your host's
# environment-variable settings (production). Never commit real values.

# Where meeting requests are delivered.
LEADS_EMAIL=pranavsairam2005@gmail.com

# A sender address on a domain you have verified in Resend,
# e.g. "Pranavs Marketing Agency <meetings@yourdomain.com>".
# (For quick tests only, Resend allows "onboarding@resend.dev", which can
# deliver only to the email address on your Resend account.)
EMAIL_FROM="Pranavs Marketing Agency <meetings@your-verified-domain.com>"

# Resend API key (server-only; never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=re_your_api_key_here
